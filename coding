              </div>
              <button onclick="resetDemoData()" class="px-4 py-2 rounded-xl font-bold bg-rose-500 text-white">Reset Data Demo</button>
            </div>
          </div>
        </div>
      `;
    }

    // ----------------------------------------------------
    // HP MOBILE RENDER HELPER FUNCTIONS (390px Rule)
    // ----------------------------------------------------
    function renderHPLayout(screen) {
      return `
        <!-- HP Header Ringkas -->
        <header class="p-4 bg-white dark:bg-[#152331] border-b border-slate-100 dark:border-slate-800/80 flex items-center justify-between shrink-0">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-babyblue flex items-center justify-center text-babyblue-dark font-bold">
              <i data-lucide="calendar-check" class="w-4 h-4 stroke-[2.5]"></i>
            </div>
            <span class="font-bold text-sm text-slate-900 dark:text-white">StudyPlan</span>
          </div>
          <button onclick="switchScreen('pengingat')" class="p-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 relative">
            <i data-lucide="bell" class="w-4 h-4"></i>
            ${appData.reminders.length ? `<span class="w-2 h-2 rounded-full bg-rose-500 absolute top-1 right-1"></span>` : ''}
          </button>
        </header>

        <!-- HP Screen Content Area -->
        <main class="flex-1 overflow-auto p-4 space-y-4">
          ${renderHPScreenBody(screen)}
        </main>

        <!-- HP Floating Action Button (+) -->
        <button onclick="switchScreen('tambah_tugas')" class="fixed bottom-16 right-5 w-12 h-12 rounded-full bg-babyblue hover:bg-babyblue-dark text-slate-900 flex items-center justify-center shadow-lg font-bold z-30">
          <i data-lucide="plus" class="w-6 h-6"></i>
        </button>

        <!-- HP Bottom Navigation Bar (5 Icons) -->
        <nav class="bg-white dark:bg-[#152331] border-t border-slate-100 dark:border-slate-800/80 grid grid-cols-5 py-2 px-1 text-[10px] font-semibold text-slate-500 dark:text-slate-400 shrink-0 z-30">
          ${renderHPNavItem('beranda', 'home', 'Beranda', screen)}
          ${renderHPNavItem('tugas', 'check-square', 'Tugas', screen)}
          ${renderHPNavItem('jadwal', 'calendar', 'Jadwal', screen)}
          ${renderHPNavItem('pengingat', 'bell', 'Pengingat', screen)}
          ${renderHPNavItem('pengaturan', 'more-horizontal', 'Lainnya', screen)}
        </nav>
      `;
    }

    function renderHPNavItem(key, icon, label, current) {
      const active = key === current;
      return `
        <button onclick="switchScreen('${key}')" class="flex flex-col items-center gap-1 ${active ? 'text-babyblue-dark dark:text-babyblue font-bold' : ''}">
          <i data-lucide="${icon}" class="w-4 h-4"></i>
          <span>${label}</span>
        </button>
      `;
    }

    function renderHPScreenBody(screen) {
      if (screen === 'beranda') return renderHPBeranda();
      if (screen === 'matakuliah') return renderLaptopMataKuliah();
      if (screen === 'tugas') return renderHPDaftarTugas();
      if (screen === 'tambah_tugas') return renderLaptopTambahTugas();
      if (screen === 'jadwal') return renderLaptopJadwal();
      if (screen === 'pengingat') return renderLaptopPengingat();
      if (screen === 'pengaturan') return renderHPPengaturan();
      return '';
    }

    function renderHPBeranda() {
      const pendingTasks = appData.tasks.filter(t => t.status === 'belum');
      const sortedPriorities = getSortedTasks(pendingTasks);

      return `
        <div class="space-y-4 text-xs">
          <div>
            <h3 class="font-bold text-base text-slate-900 dark:text-white">Beranda Mahasiswa</h3>
            <p class="text-[11px] text-slate-400">Ringkasan aktivitas hari ini</p>
          </div>

          <!-- Horizontal Scroll Stats Cards -->
          <div class="flex gap-3 overflow-x-auto no-scrollbar pb-1">
            <div class="bg-white dark:bg-[#152331] p-3.5 rounded-xl border border-slate-100 dark:border-slate-800 min-w-[130px] shrink-0">
              <span class="text-[10px] text-slate-400">Tugas Belum</span>
              <p class="text-xl font-black mt-1 text-slate-900 dark:text-white">${pendingTasks.length}</p>
            </div>
            <div class="bg-white dark:bg-[#152331] p-3.5 rounded-xl border border-slate-100 dark:border-slate-800 min-w-[130px] shrink-0">
              <span class="text-[10px] text-slate-400">Pengingat</span>
              <p class="text-xl font-black mt-1 text-slate-900 dark:text-white">${appData.reminders.length}</p>
            </div>
          </div>

          <!-- HP Tugas Terdekat List -->
          <div class="bg-white dark:bg-[#152331] p-4 rounded-xl border border-slate-100 dark:border-slate-800 space-y-3">
            <h4 class="font-bold text-xs text-slate-900 dark:text-white">Tugas Terdekat</h4>
            ${sortedPriorities.length === 0 ? `<p class="text-[11px] text-slate-400">Tidak ada tugas.</p>` : `
              <div class="space-y-2">
                ${sortedPriorities.slice(0, 3).map(t => `
                  <div class="p-3 bg-slate-50 dark:bg-[#0F1A24] rounded-lg border border-slate-100 dark:border-slate-800 flex items-center justify-between">
                    <div>
                      <p class="font-bold text-slate-800 dark:text-slate-100">${t.title}</p>
                      <p class="text-[10px] text-slate-400 mt-0.5">${getCourseName(t.courseId)}</p>
                    </div>
                    <button onclick="toggleTaskStatus('${t.id}')" class="p-1.5 rounded-lg bg-slate-200 dark:bg-slate-800"><i data-lucide="check" class="w-3.5 h-3.5"></i></button>
                  </div>
                `).join('')}
              </div>
            `}
          </div>
        </div>
      `;
    }

    function renderHPDaftarTugas() {
      const sortedTasks = getSortedTasks(appData.tasks);
      return `
        <div class="space-y-3 text-xs">
          <div class="flex items-center justify-between">
            <h3 class="font-bold text-sm text-slate-900 dark:text-white">Daftar Tugas</h3>
            <button onclick="switchScreen('tambah_tugas')" class="text-xs text-babyblue-dark font-bold">+ Tambah</button>
          </div>

          <div class="space-y-2">
            ${sortedTasks.map(t => `
              <div class="bg-white dark:bg-[#152331] p-3.5 rounded-xl border border-slate-100 dark:border-slate-800 space-y-2">
                <div class="flex items-start justify-between gap-2">
                  <h4 class="font-bold text-slate-800 dark:text-slate-100">${t.title}</h4>
                  ${getDifficultyBadgeHtml(t.difficulty)}
                </div>
                <p class="text-[11px] text-slate-400">${getCourseName(t.courseId)} • Tenggat: ${formatDateTime(t.deadline)}</p>
                <div class="flex items-center justify-between pt-2 border-t border-slate-100 dark:border-slate-800">
                  ${getStatusBadgeHtml(t.status, t.deadline)}
                  <div class="flex items-center gap-2">
                    <button onclick="toggleTaskStatus('${t.id}')" class="text-emerald-500 font-bold text-[11px]">Selesai</button>
                    <button onclick="deleteTask('${t.id}')" class="text-rose-500 font-bold text-[11px]">Hapus</button>
                  </div>
                </div>
              </div>
            `).join('')}
          </div>
        </div>
      `;
    }

    function renderHPPengaturan() {
      return `
        <div class="space-y-4 text-xs">
          <h3 class="font-bold text-sm text-slate-900 dark:text-white">Menu Lainnya</h3>
          <div class="space-y-2">
            <button onclick="switchScreen('matakuliah')" class="w-full p-3.5 bg-white dark:bg-[#152331] rounded-xl border border-slate-100 dark:border-slate-800 font-bold text-left text-slate-800 dark:text-slate-100">Kelola Mata Kuliah</button>
            <button onclick="toggleDarkMode()" class="w-full p-3.5 bg-white dark:bg-[#152331] rounded-xl border border-slate-100 dark:border-slate-800 font-bold text-left text-slate-800 dark:text-slate-100">Toggle Mode Gelap</button>
            <button onclick="resetDemoData()" class="w-full p-3.5 bg-rose-50 dark:bg-rose-950/40 text-rose-600 rounded-xl font-bold text-left">Reset Data Demo</button>
          </div>
        </div>
      `;
    }

    // ----------------------------------------------------
    // INITIALIZATION & EVENT LISTENERS
    // ----------------------------------------------------
    function renderAllViews() {
      const laptopRoot = document.getElementById('laptopAppRoot');
      const hpRoot = document.getElementById('hpAppRoot');

      laptopRoot.innerHTML = renderLaptopLayout(currentScreen);
      hpRoot.innerHTML = renderHPLayout(currentScreen);

      lucide.createIcons();
    }

    window.onload = function() {
      renderAllViews();
    };
  </script>
</body>
</html>
