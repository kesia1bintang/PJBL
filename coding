    }

    function formatDateTime(dtStr) {
      if (!dtStr) return '-';
      const d = new Date(dtStr);
      return d.toLocaleString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
    }

    function formatDateOnly(dStr) {
      if (!dStr) return '-';
      const d = new Date(dStr);
      return d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short' });
    }

    function getDifficultyBadgeHtml(level) {
      if (level == 1) return `<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#E6F4EA] text-[#137333] border border-emerald-200">Mudah (1)</span>`;
      if (level == 2) return `<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#FEF7E0] text-[#B06000] border border-amber-200">Sedang (2)</span>`;
      return `<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-[#FCE8E6] text-[#C5221F] border border-rose-200">Sulit (3)</span>`;
    }

    function getStatusBadgeHtml(status, deadlineStr) {
      if (status === 'selesai') return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300">Selesai</span>`;
      
      const deadline = new Date(deadlineStr);
      const now = new Date();
      const diffHours = (deadline - now) / (1000 * 60 * 60);

      if (diffHours <= 48 && diffHours >= 0) {
        return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-orange-100 text-orange-700 dark:bg-orange-950/60 dark:text-orange-300 animate-pulse">H-${Math.ceil(diffHours/24)} Tenggat!</span>`;
      }
      return `<span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 text-slate-700 dark:text-slate-300">Belum</span>`;
    }

