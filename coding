    function handleReminderFormSubmit(e, reminderId) {
      e.preventDefault();
      const timeVal = document.getElementById('reminderTimeInput').value;
      if (reminderId) {
        // Edit Pengingat
        const r = appData.reminders.find(item => item.id === reminderId);
        if (r) {
          r.time = timeVal;
          r.note = "Pengingat disunting manual oleh pengguna";
        }
      } else {
        // Tambah Pengingat Baru
        const taskId = document.getElementById('reminderTaskSelect').value;
        const task = appData.tasks.find(t => t.id === taskId);
        if (task) {
          appData.reminders.push({
            id: `R-CUSTOM-${Date.now()}`,
            taskId: task.id,
            title: task.title,
            courseId: task.courseId,
            time: timeVal,
            deadline: task.deadline,
            note: "Pengingat kustom pengguna"
          });
        }
      }
      appData.reminders.sort((a, b) => new Date(a.time) - new Date(b.time));
      saveAppData(appData);
      renderAllViews();
      closeModal();
      showToast('Pengingat berhasil diperbarui.', 'success');
    }

